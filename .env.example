# Copy to .env (git-ignored) and fill in your workspace values:  cp .env.example .env
# Only non-secret settings belong here. Authentication is browser OAuth (`databricks auth login`),
# which stores its tokens in ~/.databrickscfg, so no personal access token is needed.

# Workspace URL, without the ?o=... query string
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# Profile in ~/.databrickscfg that the CLI uses
DATABRICKS_CONFIG_PROFILE=DEFAULT
# Optional: SQL warehouse for setup SQL. When empty, the script uses the first warehouse
# (Free Edition only has the "Serverless Starter Warehouse"). Find it with `databricks warehouses list`.
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog names
CATALOG=medallion
BRONZE_SCHEMA=00_bronze
SILVER_SCHEMA=01_silver
GOLD_SCHEMA=02_gold
